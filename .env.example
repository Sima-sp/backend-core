# Copie para .env e preencha. O .env nao vai para o git.
# allowPublicKeyRetrieval=true e necessario com MySQL 8+ sem TLS (autenticacao caching_sha2_password).
DB_URL=jdbc:mysql://localhost:3306/simasp_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USERNAME=root
DB_PASSWORD=senha
# Chave HMAC em Base64 com pelo menos 32 bytes: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-base64
# Servico de IA (ml-service)
IA_HABILITADA=true
IA_URL=http://localhost:5000
# Modo de demonstracao: permite simular chuva pelo /admin/demonstracao. Deixe false fora de apresentacoes.
IA_DEMONSTRACAO=false
